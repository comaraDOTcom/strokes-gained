# Copy to .env.local for local work. Vercel gets the same names in Project → Settings → Environment Variables.
# NEVER commit real values (.env* is gitignored).

# --- Database -----------------------------------------------------------------------------
# Production (Neon): a Postgres connection string. Leave UNSET locally to use PGlite
# (in-process Postgres stored in data/pglite — no install needed).
# DATABASE_URL=postgres://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
# PGLITE_DIR=data/pglite

# --- Auth (Better Auth + Google) --------------------------------------------------------------
# openssl rand -base64 32   — without this, auth refuses to run (fails closed)
BETTER_AUTH_SECRET=
# The site's public origin: http://localhost:3000 locally, https://<your-app>.vercel.app in production
BETTER_AUTH_URL=http://localhost:3000
# Google Cloud Console → APIs & Services → Credentials → OAuth client (Web application).
# Authorised redirect URI:  <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Access control ---------------------------------------------------------------------------
# Your Google address. You can always sign up, you're the admin, and you inherit the rounds
# imported from the old single-user database the first time you sign in.
ADMIN_EMAIL=
# The secret in the WhatsApp link:  https://<your-app>/join/<INVITE_TOKEN>
# Change it to stop new people joining with the old link (existing members are unaffected).
INVITE_TOKEN=

# --- Local development ONLY ---------------------------------------------------------------
# Enables a fake email sign-in box on /login so you can try the app without Google.
# Ignored when NODE_ENV=production.
# AUTH_TEST_MODE=1

# --- Course data (optional, admin tooling only) ---------------------------------------------
# golfcourseapi.com key for `pnpm courses:api` (free tier: 35 requests/day). Not needed by the app.
# GOLFCOURSEAPI_KEY=

# --- Email notifications (optional) -------------------------------------------------------------
# resend.com API key. When set, a new course request emails ADMIN_EMAIL. The free tier can send to
# the Resend account owner's own address from onboarding@resend.dev with no domain setup — so sign
# up to Resend with the same address as ADMIN_EMAIL. Without a key, requests still show in the
# admin's Courses page.
# RESEND_API_KEY=
# NOTIFY_FROM=Strokes Gained <onboarding@resend.dev>

# Optional: map tiles for the Played page. Default is OpenStreetMap's standard tiles (no key).
# To use a keyed provider instead, e.g. MapTiler:
# NEXT_PUBLIC_MAP_TILE_URL=https://api.maptiler.com/maps/streets-v2/{z}/{x}/{y}.png?key=YOUR_KEY
# NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=&copy; MapTiler &copy; OpenStreetMap contributors
